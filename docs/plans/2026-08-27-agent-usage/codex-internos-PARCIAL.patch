+/// FORK: the proactive knob and the playbook toggle parse from the table.
+#[test]
+fn multi_agent_v2_feature_config_deserializes_proactive_knob() {
+    let features: FeaturesToml = toml::from_str(
+        r#"
+[multi_agent_v2]
+proactive = "always"
+delegation_playbook_hint = false
+"#,
+    )
+    .expect("features table should deserialize");
+
+    let Some(crate::FeatureToml::Config(config)) = features.multi_agent_v2 else {
+        panic!("expected a multi_agent_v2 table");
+    };
+    assert_eq!(
+        config.proactive,
+        Some(crate::MultiAgentProactiveDelegation::Always)
+    );
+    assert_eq!(config.delegation_playbook_hint, Some(false));
+    assert!(toml::from_str::<FeaturesToml>("[multi_agent_v2]
+proactive = \"sometimes\"
+").is_err());
+}
