+pub(crate) fn proactive_delegation(turn_context: &TurnContext) -> bool {
+    match effective_multi_agent_mode(turn_context) {
+        Some(MultiAgentMode::Proactive) => true,
+        Some(MultiAgentMode::Custom(_)) => matches!(
+            turn_context.config.multi_agent_v2.proactive,
