+/// FORK: applies `[agents] max_fork_turns` to a child served by a model endpoint.
+///
+/// Locally served children have their own ceiling (above). For everyone else
+/// a full-history fork copies the entire parent transcript into the child,
+/// which on long sessions is the dominant cost of a spawn; the cap turns it
+/// into a recent-turns fork and says so.
+pub(crate) fn apply_endpoint_fork_cap(
+    wire_api: WireApi,
+    fork_mode: Option<SpawnAgentForkMode>,
+    max_fork_turns: Option<usize>,
+) -> (Option<SpawnAgentForkMode>, Option<String>) {
+    let (WireApi::Responses, Some(cap)) = (wire_api, max_fork_turns) else {
+        return (fork_mode, None);
+    };
+    let capped = |turns: usize| {
+        if cap == 0 {
+            None
+        } else {
+            Some(SpawnAgentForkMode::LastNTurns(turns))
+        }
+    };
+    match fork_mode {
+        Some(SpawnAgentForkMode::FullHistory) => (
+            capped(cap),
+            Some(format!(
+                "`fork_turns: \"all\"` was reduced to {cap} by `[agents] max_fork_turns`; the child saw only the most recent turns."
+            )),
+        ),
+        Some(SpawnAgentForkMode::LastNTurns(requested)) if requested > cap => (
+            capped(cap),
+            Some(format!(
+                "`fork_turns` was reduced from {requested} to {cap} by `[agents] max_fork_turns`."
+            )),
+        ),
+        other => (other, None),
+    }
+}
