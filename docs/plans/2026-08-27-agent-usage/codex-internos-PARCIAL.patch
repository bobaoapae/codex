+#[tokio::test]
+async fn multi_agent_v2_wait_agent_backs_off_after_a_silent_timeout() {
+    let (session, mut turn) = make_session_and_context().await;
+    let mut config = (*turn.config).clone();
+    config
+        .features
+        .enable(Feature::MultiAgentV2)
+        .expect("test config should allow feature update");
+    config.multi_agent_v2.min_wait_timeout_ms = 50;
+    config.multi_agent_v2.max_wait_timeout_ms = 150;
+    config.multi_agent_v2.default_wait_timeout_ms = 50;
+    set_turn_config(&mut turn, config);
+    let session = Arc::new(session);
+    let turn = Arc::new(turn);
+    let handler = WaitAgentHandlerV2::default();
+
+    tokio::time::pause();
+    let mut elapsed = Vec::new();
+    let mut messages = Vec::new();
+    for _ in 0..3 {
+        let started_at = tokio::time::Instant::now();
+        let output = handler
+            .handle(invocation(
+                Arc::clone(&session),
+                Arc::clone(&turn),
+                "wait_agent",
+                function_payload(json!({"timeout_ms": 50})),
+            ))
+            .await
+            .expect("wait_agent should succeed");
+        elapsed.push(started_at.elapsed());
+        let (content, _) = expect_text_output(output);
+        let result: crate::tools::handlers::multi_agents_v2::wait::WaitAgentResult =
+            serde_json::from_str(&content).expect("wait_agent result should be json");
+        assert!(result.timed_out);
+        messages.push(result.message);
+    }
+    tokio::time::resume();
+
+    let within = |actual: Duration, expected_ms: u64| {
+        actual >= Duration::from_millis(expected_ms)
+            && actual <= Duration::from_millis(expected_ms + 1)
+    };
+    assert!(within(elapsed[0], 50), "first wait: {:?}", elapsed[0]);
+    assert!(within(elapsed[1], 100), "second wait doubled: {:?}", elapsed[1]);
+    // Capped at max_wait_timeout_ms, not 200.
+    assert!(within(elapsed[2], 150), "third wait capped: {:?}", elapsed[2]);
+    assert!(messages[0].starts_with("Wait timed out."), "{}", messages[0]);
+    assert!(!messages[0].contains("previous wait expired"), "{}", messages[0]);
+    assert!(
+        messages[1].contains("The previous wait expired with no activity, so this one waited 100ms."),
+        "{}",
+        messages[1]
+    );
+    assert!(messages[2].contains("waited 150ms."), "{}", messages[2]);
+}
