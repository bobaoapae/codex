+/// FORK: a `fork_turns` value as configured (`[agents] default_fork_turns`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum AgentForkTurns {
+    /// Full-history fork (`"all"`).
+    All,
+    /// Task-only context (`"none"`).
+    None,
+    /// The most recent `n` turns (a positive integer string).
+    LastN(usize),
+}
+
+impl AgentForkTurns {
+    /// Parses the same vocabulary `spawn_agent` accepts for `fork_turns`.
+    pub fn parse(value: &str) -> Option<Self> {
+        let value = value.trim();
+        if value.eq_ignore_ascii_case("all") {
+            return Some(Self::All);
+        }
+        if value.eq_ignore_ascii_case("none") {
+            return Some(Self::None);
+        }
+        match value.parse::<usize>() {
+            Ok(turns) if turns > 0 => Some(Self::LastN(turns)),
+            _ => Option::None,
+        }
+    }
+
+    /// The `fork_turns` string the tool description should advertise.
+    pub fn as_tool_value(self) -> String {
+        match self {
+            Self::All => "all".to_string(),
+            Self::None => "none".to_string(),
+            Self::LastN(turns) => turns.to_string(),
+        }
+    }
+}
+
+impl Default for AgentForkTurns {
+    fn default() -> Self {
+        Self::All
+    }
+}
